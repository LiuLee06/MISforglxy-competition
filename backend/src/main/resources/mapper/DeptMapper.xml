<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sdjzuxg.collegemanagesystem.mapper.DeptMapper">
    <select id="selectAll" resultType="com.sdjzuxg.collegemanagesystem.entity.Dept">
        SELECT * FROM DEPT
    </select>
    <select id="selectById" parameterType="Integer" resultType="com.sdjzuxg.collegemanagesystem.entity.Dept">
        SELECT * FROM DEPT WHERE dept_id = #{deptId}
    </select>
    <insert id="insert" parameterType="com.sdjzuxg.collegemanagesystem.entity.Dept">
        INSERT INTO DEPT (dept_name, dept_desc) VALUES (#{deptName}, #{deptDesc})
    </insert>
    <update id="update" parameterType="com.sdjzuxg.collegemanagesystem.entity.Dept">
        UPDATE DEPT SET dept_name = #{deptName}, dept_desc = #{deptDesc} WHERE dept_id = #{deptId}
    </update>
    <delete id="deleteById" parameterType="Integer">
        DELETE FROM DEPT WHERE dept_id = #{deptId}
    </delete>
    <select id="selectDeptStatistics" resultType="java.util.HashMap">
        SELECT
            d.dept_id AS deptId,
            d.dept_name AS deptName,
            d.dept_desc AS deptDesc,
            COUNT(td.teacher_id) AS teacherCount
        FROM DEPT d
                 LEFT JOIN TEACHER_DEPT td ON d.dept_id = td.dept_id
        GROUP BY d.dept_id
        ORDER BY teacherCount DESC
    </select>
    <select id="selectIdsByNames" resultType="Integer">
        SELECT dept_id FROM DEPT WHERE dept_name IN
        <foreach collection="names" item="name" open="(" separator="," close=")">
            #{name}
        </foreach>
    </select>
</mapper>