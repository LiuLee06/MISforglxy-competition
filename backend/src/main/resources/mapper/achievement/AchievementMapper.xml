<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sdjzuxg.collegemanagesystem.achievement.mapper.AchievementMapper">

    <!-- 动态筛选条件：所有页面上传统计与列表共用，保证口径一致 -->
    <sql id="whereClause">
        <where>
            <if test="q.status != null">AND status = #{q.status}</if>
            <if test="q.category != null and q.category != ''">AND category = #{q.category}</if>
            <if test="q.level != null and q.level != ''">AND level = #{q.level}</if>
            <if test="q.name != null and q.name != ''">AND name LIKE CONCAT('%', #{q.name}, '%')</if>
            <if test="q.person != null and q.person != ''">AND persons LIKE CONCAT('%', #{q.person}, '%')</if>
            <if test="q.startDate != null and q.startDate != ''">AND achieve_date &gt;= #{q.startDate}</if>
            <if test="q.endDate != null and q.endDate != ''">AND achieve_date &lt;= #{q.endDate}</if>
            <if test="q.submitStart != null and q.submitStart != ''">AND submit_time &gt;= CONCAT(#{q.submitStart}, ' 00:00:00')</if>
            <if test="q.submitEnd != null and q.submitEnd != ''">AND submit_time &lt;= CONCAT(#{q.submitEnd}, ' 23:59:59')</if>
        </where>
    </sql>

    <resultMap id="achievementMap" type="com.sdjzuxg.collegemanagesystem.achievement.entity.Achievement">
        <id column="id" property="id"/>
        <result column="category" property="category"/>
        <result column="classify_level" property="classifyLevel"/>
        <result column="name" property="name"/>
        <result column="persons" property="persons"/>
        <result column="level" property="level"/>
        <result column="grade" property="grade"/>
        <result column="achieve_date" property="achieveDate"/>
        <result column="issuer" property="issuer"/>
        <result column="contest_name" property="contestName"/>
        <result column="file_name" property="fileName"/>
        <result column="file_url" property="fileUrl"/>
        <result column="ocr_filled" property="ocrFilled"/>
        <result column="status" property="status"/>
        <result column="verify_time" property="verifyTime"/>
        <result column="verify_remark" property="verifyRemark"/>
        <result column="submit_time" property="submitTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="countByConditions" resultType="long">
        SELECT COUNT(*) FROM achievement
        <include refid="whereClause"/>
    </select>

    <select id="selectByConditions" resultMap="achievementMap">
        SELECT * FROM achievement
        <include refid="whereClause"/>
        ORDER BY submit_time DESC, id DESC
        LIMIT #{q.size} OFFSET #{q.offset}
    </select>

    <select id="selectById" resultMap="achievementMap">
        SELECT * FROM achievement WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.sdjzuxg.collegemanagesystem.achievement.entity.Achievement"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO achievement
        (category, classify_level, name, persons, level, grade, achieve_date, issuer,
         contest_name, file_name, file_url, ocr_filled, status)
        VALUES
        (#{category}, #{classifyLevel}, #{name}, #{persons}, #{level}, #{grade}, #{achieveDate}, #{issuer},
         #{contestName}, #{fileName}, #{fileUrl}, #{ocrFilled}, 0)
    </insert>

    <update id="update" parameterType="com.sdjzuxg.collegemanagesystem.achievement.entity.Achievement">
        UPDATE achievement
        SET category      = #{category},
            classify_level = #{classifyLevel},
            name          = #{name},
            persons       = #{persons},
            level         = #{level},
            grade         = #{grade},
            achieve_date  = #{achieveDate},
            issuer        = #{issuer},
            contest_name  = #{contestName}
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE achievement SET status = #{status}, verify_time = NOW() WHERE id = #{id}
    </update>

    <!-- 批量通过：只更新仍处于待验证状态的记录，防止重复审核 -->
    <update id="batchPass">
        UPDATE achievement SET status = 1, verify_time = NOW()
        WHERE status = 0
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="deleteById">
        DELETE FROM achievement WHERE id = #{id}
    </delete>

    <delete id="deleteBatch">
        DELETE FROM achievement WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countPassed" resultType="long">
        SELECT COUNT(*) FROM achievement
        <include refid="whereClause"/>
    </select>

    <select id="selectLevelStats" resultType="java.util.HashMap">
        SELECT level AS lvl, COUNT(*) AS cnt FROM achievement
        <include refid="whereClause"/>
        GROUP BY level
    </select>

    <select id="selectCategoryStats" resultType="java.util.HashMap">
        SELECT category AS cate, COUNT(*) AS cnt FROM achievement
        <include refid="whereClause"/>
        GROUP BY category
    </select>

    <select id="selectYearStats" resultType="java.util.HashMap">
        SELECT DATE_FORMAT(achieve_date, '%Y') AS yr, COUNT(*) AS cnt FROM achievement
        <include refid="whereClause"/>
        GROUP BY yr
        ORDER BY yr
    </select>

    <select id="selectExport" resultMap="achievementMap">
        SELECT * FROM achievement
        <include refid="whereClause"/>
        ORDER BY submit_time DESC, id DESC
    </select>
</mapper>
