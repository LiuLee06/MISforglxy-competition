<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sdjzuxg.collegemanagesystem.mapper.TeacherDeptMapper">
    <select id="selectAll" resultType="com.sdjzuxg.collegemanagesystem.entity.TeacherDept">
        SELECT * FROM TEACHER_DEPT
    </select>
    <select id="selectById" parameterType="Integer" resultType="com.sdjzuxg.collegemanagesystem.entity.TeacherDept">
        SELECT * FROM TEACHER_DEPT WHERE id = #{id}
    </select>
    <select id="selectByTeacherId" parameterType="Integer" resultType="com.sdjzuxg.collegemanagesystem.entity.TeacherDept">
        SELECT * FROM TEACHER_DEPT WHERE teacher_id = #{teacherId}
    </select>
    <insert id="insert" parameterType="com.sdjzuxg.collegemanagesystem.entity.TeacherDept">
        INSERT INTO TEACHER_DEPT (teacher_id, dept_id) VALUES (#{teacher.teacherId}, #{dept.deptId})
    </insert>
    <update id="update" parameterType="com.sdjzuxg.collegemanagesystem.entity.TeacherDept">
        UPDATE TEACHER_DEPT SET teacher_id = #{teacher.teacherId}, dept_id = #{dept.deptId} WHERE id = #{id}
    </update>
    <delete id="deleteById" parameterType="Integer">
        DELETE FROM TEACHER_DEPT WHERE id = #{id}
    </delete>
    <delete id="deleteByTeacherId">
        DELETE FROM TEACHER_DEPT WHERE teacher_id = #{teacherId}
    </delete>
    <insert id="batchInsert">
        INSERT INTO TEACHER_DEPT (teacher_id, dept_id) VALUES
        <foreach collection="deptIds" item="deptId" separator=",">
            (#{teacherId}, #{deptId})
        </foreach>
    </insert>
</mapper>